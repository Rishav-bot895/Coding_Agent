# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# Testing & Quality caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local session workspaces
.localdev_session/
session_*

# IDEs
.vscode/
.idea/
*.swp

demo/


# Fine-tuning model artifacts and binary weights (stored in project directory only)
models/**/*.safetensors
models/**/*.bin
models/**/*.gguf
models/**/*.pt
models/**/*.pth
models/finetune/fused/
models/finetune/gguf/
models/finetune/smoke_test_adapter/
models/finetune/smoke_export/
models/finetune/qlora_adapter/
!models/.gitkeep
!models/finetune/.gitkeep

# Fine-tuning datasets (keep manifest.json and schema templates; ignore large jsonl splits)
datasets/finetune/*.jsonl
!datasets/.gitkeep
!datasets/finetune/.gitkeep
!datasets/finetune/manifest.json